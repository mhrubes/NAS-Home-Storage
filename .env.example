# Zkopiruj do .env a vypln. Hash vygeneruj: npm run hash -- "heslo"
APP_USER=admin
APP_PASSWORD_HASH=
SESSION_SECRET=

PORT=3000
# Port vystaveny na NASu (docker compose); uvnitr kontejneru zustava PORT=3000
APP_PORT=3001
# Lokalni vyvoj: ./data. V Dockeru kompozice prepise na /data.
STORAGE_DIR=./data
# Cesta na NASu pro docker compose volume
STORAGE_PATH=/volume1/storage
MAX_UPLOAD_MB=2048

# Po kolika dnech se smazou polozky v kosi (vychozi 30). 0 = kos vypnuty, mazani je trvale.
TRASH_DAYS=30

# Automaticke odhlaseni po necinnosti v minutach (vychozi 10). Aktivita na strance odpocet obnovi.
SESSION_TIMEOUT_MIN=10

# Za HTTPS reverse proxy nastav obe na true
COOKIE_SECURE=false
TRUST_PROXY=false
